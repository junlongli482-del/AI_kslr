MINERU_BASE_URL=https://mineru.net
MINERU_API_KEY=
LLM_STABLE_BASE_URL=https://gpt.huaiapi.xyz/v1
LLM_STABLE_MODEL=gpt-6.1-sol
LLM_STABLE_API_KEY=
LLM_CHANNEL_POLICY=low_first
DATABASE_URL=jdbc:postgresql://localhost:55436/quickentry
DB_USER=quickentry
DB_PASSWORD=local-development-only
AI_SERVICE_URL=http://127.0.0.1:8091
QUICK_ENTRY_DATA_DIR=./data
QUICK_ENTRY_MAX_CONCURRENCY=0
QUICK_ENTRY_STAGE_TIMEOUT_SECONDS=600
QUICK_ENTRY_MAX_ATTEMPTS=3

LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEEPSEEK_MODEL=deepseek-flash
LLM_DEEPSEEK_API_KEY=
LLM_READ_TIMEOUT_SECONDS=1800
LLM_CONNECT_TIMEOUT_SECONDS=25
LLM_CLAUDE_BASE_URL=https://gpt.huaiapi.xyz
LLM_CLAUDE_MODEL=claude-sonnet-5-5
LLM_CLAUDE_PROTOCOL=anthropic
LLM_CLAUDE_API_KEY=
LLM_GEMINI_BASE_URL=https://gpt.huaiapi.xyz
LLM_GEMINI_MODEL=gemini-4-argon
LLM_GEMINI_PROTOCOL=responses
LLM_GEMINI_API_KEY=
LLM_MINIMAX_BASE_URL=https://gpt.huaiapi.xyz
LLM_MINIMAX_MODEL=MiniMax-M3
LLM_MINIMAX_PROTOCOL=responses
LLM_MINIMAX_API_KEY=
LLM_GLM_BASE_URL=https://gpt.huaiapi.xyz
LLM_GLM_MODEL=glm-5.3-flash
LLM_GLM_PROTOCOL=responses
LLM_GLM_API_KEY=
# Optional: only for a provider that requires an explicit output ceiling; leave empty to send no cap.
# LLM_MAX_OUTPUT_TOKENS=

# Bracket detection worker (PicoDet_layout_1x)
# Set BRACKET_ENABLED=1 and point BRACKET_PYTHON/PYTHONPATH at the isolated Paddle environment.
BRACKET_ENABLED=0
BRACKET_PYTHON=
BRACKET_PYTHONPATH=
BRACKET_MODEL_DIR=
BRACKET_TIMEOUT=600

# 本地 MinerU（可选）：auto 先本地后云端，local 只用本地，cloud 只用云端
MINERU_PROVIDER=auto
MINERU_LOCAL_URL=http://127.0.0.1:8020
MINERU_LOCAL_TIER=standard
MINERU_LOCAL_TIMEOUT=600
# 云端多密钥，逗号分隔，失败自动切换
MINERU_API_KEYS=
