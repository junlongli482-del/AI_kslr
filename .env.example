LLM_STABLE_MODEL=gpt-6.1-sol
LLM_STABLE_API_KEY=
LLM_CHANNEL_POLICY=low_first
DATABASE_URL=jdbc:postgresql://localhost:55436/quickentry
DB_USER=quickentry
DB_PASSWORD=local-development-only
AI_SERVICE_URL=http://127.0.0.1:8091
QUICK_ENTRY_DATA_DIR=./data
QUICK_ENTRY_MAX_CONCURRENCY=0
QUICK_ENTRY_STAGE_TIMEOUT_SECONDS=600
QUICK_ENTRY_MAX_ATTEMPTS=3

LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEEPSEEK_MODEL=deepseek-flash
LLM_DEEPSEEK_API_KEY=
LLM_READ_TIMEOUT_SECONDS=1800
LLM_CONNECT_TIMEOUT_SECONDS=25
LLM_CLAUDE_BASE_URL=https://gpt.huaiapi.xyz
LLM_CLAUDE_MODEL=claude-sonnet-5-5
